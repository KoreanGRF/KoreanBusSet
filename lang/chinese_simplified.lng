STR_PARAM_OPT_FACTOR_BY_1_2_DEFAULT                       :x1/2(默认)
STR_PARAM_OPT_FACTOR_BY_1_DEFAULT                         :x1(默认)
STR_PARAM_OPT_FACTOR_BY_1                                 :x1
STR_PARAM_OPT_FACTOR_BY_2                                 :x2
STR_PARAM_OPT_FACTOR_BY_4                                 :x4
STR_PARAM_OPT_FACTOR_BY_8                                 :x8
